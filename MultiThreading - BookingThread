
class TicketBooking {
    String passengerName;

    TicketBooking(String name) {
        passengerName = name;
    }

    void display() {
        System.out.println("Passenger: " + passengerName);
        System.out.println("Booking Status: Confirmed");
        System.out.println("Thread: " +
            Thread.currentThread().getName());
        System.out.println("----------------------");
    }
}

class BookingThread extends Thread {
    TicketBooking booking;

    BookingThread(TicketBooking booking) {
        this.booking = booking;
    }

    public void run() {
        booking.display();
    }
}

class BookingRunnable implements Runnable {
    TicketBooking booking;

    BookingRunnable(TicketBooking booking) {
        this.booking = booking;
    }

    public void run() {
        booking.display();
    }
}

public class RailwayReservation {
    public static void main(String[] args) {
        TicketBooking b1 = new TicketBooking("Rahul");
        TicketBooking b2 = new TicketBooking("Priya");
        TicketBooking b3 = new TicketBooking("Aman");
        TicketBooking b4 = new TicketBooking("Neha");

        BookingThread t1 = new BookingThread(b1);
        BookingThread t2 = new BookingThread(b2);

        Thread t3 = new Thread(new BookingRunnable(b3));
        Thread t4 = new Thread(new BookingRunnable(b4));

        t1.start();
        t2.start();
        t3.start();
        t4.start();

        try {
            t1.join();
            t2.join();
            t3.join();
            t4.join();
        } catch (InterruptedException e) {
            System.out.println("Thread interrupted");
            Thread.currentThread().interrupt();
        }

        System.out.println("All booking requests processed successfully.");
    }
}
