
import java.io.*;
import java.util.Scanner;

class LibraryTransaction {
    String bookId, bookName, studentName, issueDate, returnDate;

    LibraryTransaction(String id, String book, String student,
                       String issue, String ret) {
        bookId = id;
        bookName = book;
        studentName = student;
        issueDate = issue;
        returnDate = ret;
    }

    public String toString() {
        return "Book ID: " + bookId
                + "\nBook Name: " + bookName
                + "\nStudent Name: " + studentName
                + "\nIssue Date: " + issueDate
                + "\nReturn Date: " + returnDate
                + "\n-------------------------";
    }

    void save() throws IOException {
        FileWriter fw = new FileWriter("transactions.txt", true);
        fw.write(bookId + "|" + bookName + "|" + studentName
                + "|" + issueDate + "|" + returnDate + "\n");
        fw.close();
    }
}

public class LibraryFileHandling {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int choice;

        do {
            System.out.println("\n1. Record Book Transaction");
            System.out.println("2. View Transaction Records");
            System.out.println("3. Exit");
            System.out.print("Enter choice: ");
            choice = sc.nextInt();
            sc.nextLine();

            try {
                if (choice == 1) {
                    System.out.print("Enter Book ID: ");
                    String id = sc.nextLine();
                    System.out.print("Enter Book Name: ");
                    String book = sc.nextLine();
                    System.out.print("Enter Student Name: ");
                    String student = sc.nextLine();
                    System.out.print("Enter Issue Date: ");
                    String issue = sc.nextLine();
                    System.out.print("Enter Return Date: ");
                    String ret = sc.nextLine();

                    if (id.isEmpty() || book.isEmpty()
                            || student.isEmpty() || issue.isEmpty()
                            || ret.isEmpty()) {
                        System.out.println("All details are required.");
                    } else {
                        LibraryTransaction t =
                            new LibraryTransaction(id, book, student,
                                                   issue, ret);
                        t.save();
                        System.out.println(
                            "Transaction recorded successfully.");
                    }
                } else if (choice == 2) {
                    File file = new File("transactions.txt");

                    if (!file.exists() || file.length() == 0) {
                        System.out.println("No transaction records found.");
                    } else {
                        BufferedReader br =
                            new BufferedReader(new FileReader(file));
                        String line;

                        while ((line = br.readLine()) != null) {
                            String[] data = line.split("\\|", -1);
                            System.out.println(
                                "Book ID: " + data[0]
                                + "\nBook Name: " + data[1]
                                + "\nStudent Name: " + data[2]
                                + "\nIssue Date: " + data[3]
                                + "\nReturn Date: " + data[4]
                                + "\n-------------------------");
                        }
                        br.close();
                    }
                } else if (choice == 3) {
                    System.out.println("Exiting Library Management System.");
                } else {
                    System.out.println(
                        "Invalid choice. Please select a valid option.");
                }
            } catch (IOException e) {
                System.out.println("File error: " + e.getMessage());
            }
        } while (choice != 3);

        sc.close();
    }
}
