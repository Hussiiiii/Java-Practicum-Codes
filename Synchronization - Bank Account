
class BankAccount {
    int accountNumber;
    String holderName;
    double balance;

    BankAccount(int number, String name, double balance) {
        accountNumber = number;
        holderName = name;
        this.balance = balance;
    }

    synchronized void deposit(double amount, String user) {
        if (amount <= 0) {
            System.out.println(user + ": Invalid deposit amount");
            return;
        }

        balance += amount;
        System.out.println(user + " deposited Rs." + amount);
        displayBalance();
    }

    synchronized void withdraw(double amount, String user) {
        if (amount <= 0) {
            System.out.println(user + ": Invalid withdrawal amount");
        } else if (amount > balance) {
            System.out.println(user + ": Insufficient balance");
        } else {
            balance -= amount;
            System.out.println(user + " withdrew Rs." + amount);
        }

        displayBalance();
    }

    void displayBalance() {
        System.out.println("Current balance: Rs." + balance);
    }
}

class UserTransaction extends Thread {
    BankAccount account;
    String user;
    String type;
    double amount;

    UserTransaction(BankAccount account, String user,
                    String type, double amount) {
        this.account = account;
        this.user = user;
        this.type = type;
        this.amount = amount;
    }

    public void run() {
        if (type.equalsIgnoreCase("deposit")) {
            account.deposit(amount, user);
        } else {
            account.withdraw(amount, user);
        }
    }
}

public class BankSynchronization {
    public static void main(String[] args) {
        BankAccount account =
            new BankAccount(101, "Rahul", 10000);

        UserTransaction t1 =
            new UserTransaction(account, "User1", "deposit", 2000);

        UserTransaction t2 =
            new UserTransaction(account, "User2", "withdraw", 3000);

        UserTransaction t3 =
            new UserTransaction(account, "User3", "deposit", 1000);

        UserTransaction t4 =
            new UserTransaction(account, "User4", "withdraw", 2000);

        t1.start();
        t2.start();
        t3.start();
        t4.start();

        try {
            t1.join();
            t2.join();
            t3.join();
            t4.join();
        } catch (InterruptedException e) {
            System.out.println("Transaction interrupted");
            Thread.currentThread().interrupt();
        }

        System.out.println("\n--- Final Account Details ---");
        System.out.println("Account Number: " + account.accountNumber);
        System.out.println("Account Holder: " + account.holderName);
        account.displayBalance();
    }
}
